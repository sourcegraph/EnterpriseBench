# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.venv/
venv/
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Environment
.env
.env.local
*.env

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Benchmark runs
runs/staging/
runs/official/_quarantine/
runs/

# Chain-run artifacts written into the task source dir (chain_runner.py writes
# both into benchmarks/<suite>/<task_id>/; keep them out of the tracked tree)
benchmarks/**/results.json
benchmarks/**/chain_result.json

# Benchmark result outputs — generated agent stdout/stderr/traces, sweep logs,
# smoke/pilot/batch runs. Curated analysis + sample runs are kept (un-ignored).
results/*
!results/analysis/
!results/sample_runs/
!results/solve_verification_report.json

# Sandbox artifacts
*.tar.gz
*.docker

# Generated Dockerfiles (created by run_task.py at build time)
benchmarks/**/environment/Dockerfile
benchmarks/**/environment/Dockerfile.*

# Prototype worktrees (managed by /diverge-prototype)
.worktrees/

# Infra account config (contains PII — use accounts_config.json.example as template)
scripts/infra/accounts_config.json

# Beads / Dolt files (added by bd init)
.dolt/
.beads/
.brainstorm/
.claude/
.codegraph/
.codex/
.gc/
.runtime/
*.db
.beads-credential-key

# Agent audit/status reports (local, not tracked)
.gc-reports/

# secrets backups (never commit)
.env.local.bak*
*.bak-rryas2
